  "components": {
    "schemas": {
      "ExperimentContract": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "experiment/v1",
            "title": "Schema Version",
            "default": "experiment/v1"
          },
          "strategy_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Strategy Hash"
          },
          "dataset_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Dataset Hash"
          },
          "instrument_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Instrument Hash"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "code_revision": {
            "type": "string",
            "title": "Code Revision"
          },
          "fill_version": {
            "type": "string",
            "title": "Fill Version"
          },
          "evaluation_policy": {
            "type": "string",
            "title": "Evaluation Policy"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "historical-reference/v1",
              "historical-pessimistic/v1"
            ],
            "title": "Scenario"
          },
          "windows": {
            "items": {
              "$ref": "#/components/schemas/Window"
            },
            "type": "array",
            "title": "Windows"
          },
          "seed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seed"
          },
          "initial_equity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Initial Equity",
            "default": "20"
          },
          "risk_fraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Risk Fraction",
            "default": "0.10"
          },
          "overlap_policy": {
            "type": "string",
            "const": "one-position",
            "title": "Overlap Policy",
            "default": "one-position"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "strategy_hash",
          "dataset_hash",
          "instrument_hash",
          "engine_version",
