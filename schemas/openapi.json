{
  "components": {
    "schemas": {
      "ExperimentContract": {
        "additionalProperties": false,
        "properties": {
          "code_revision": {
            "title": "Code Revision",
            "type": "string"
          },
          "dataset_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Dataset Hash",
            "type": "string"
          },
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "evaluation_policy": {
            "title": "Evaluation Policy",
            "type": "string"
          },
          "fill_version": {
            "title": "Fill Version",
            "type": "string"
          },
          "initial_equity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "20",
            "title": "Initial Equity"
          },
          "instrument_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Instrument Hash",
            "type": "string"
          },
          "overlap_policy": {
            "const": "one-position",
            "default": "one-position",
            "title": "Overlap Policy",
            "type": "string"
          },
          "risk_fraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "0.10",
            "title": "Risk Fraction"
          },
          "scenario": {
            "enum": [
              "historical-reference/v1",
              "historical-pessimistic/v1"
            ],
            "title": "Scenario",
            "type": "string"
          },
          "schema_version": {
            "const": "experiment/v1",
            "default": "experiment/v1",
            "title": "Schema Version",
            "type": "string"
          },
          "seed": {
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "strategy_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Strategy Hash",
            "type": "string"
          },
          "windows": {
            "items": {
              "$ref": "#/components/schemas/Window"
            },
            "title": "Windows",
            "type": "array"
          }
        },
        "required": [
          "strategy_hash",
          "dataset_hash",
          "instrument_hash",
          "engine_version",
          "code_revision",
          "fill_version",
          "evaluation_policy",
          "scenario",
          "windows",
          "seed"
        ],
        "title": "ExperimentContract",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InstrumentSpec": {
        "additionalProperties": false,
        "properties": {
          "base_currency": {
            "title": "Base Currency",
            "type": "string"
          },
          "contract_multiplier": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Contract Multiplier"
          },
          "instrument": {
            "title": "Instrument",
            "type": "string"
          },
          "margin_rate": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 1.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Margin Rate"
          },
          "max_volume": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Max Volume"
          },
          "min_stop_ticks": {
            "minimum": 1.0,
            "title": "Min Stop Ticks",
            "type": "integer"
          },
          "min_volume": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Min Volume"
          },
          "pip_size": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Pip Size"
          },
          "price_scale": {
            "exclusiveMinimum": 0.0,
            "title": "Price Scale",
            "type": "integer"
          },
          "quote_currency": {
            "title": "Quote Currency",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "tick_size": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Tick Size"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "volume_step": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Volume Step"
          }
        },
        "required": [
          "instrument",
          "version",
          "tick_size",
          "pip_size",
          "price_scale",
          "base_currency",
          "quote_currency",
          "contract_multiplier",
          "volume_step",
          "min_volume",
          "max_volume",
          "margin_rate",
          "min_stop_ticks",
          "source",
          "synthetic"
        ],
        "title": "InstrumentSpec",
        "type": "object"
      },
      "Proposal": {
        "additionalProperties": false,
        "properties": {
          "contract": {
            "$ref": "#/components/schemas/ExperimentContract"
          },
          "profile": {
            "$ref": "#/components/schemas/InstrumentSpec"
          },
          "strategy": {
            "$ref": "#/components/schemas/StrategySpec"
          }
        },
        "required": [
          "strategy",
          "contract",
          "profile"
        ],
        "title": "Proposal",
        "type": "object"
      },
      "SearchProtocol": {
        "additionalProperties": false,
        "properties": {
          "code_revision": {
            "title": "Code Revision",
            "type": "string"
          },
          "confirmation_options": {
            "default": [
              "none"
            ],
            "items": {
              "type": "string"
            },
            "title": "Confirmation Options",
            "type": "array"
          },
          "cpu_budget_seconds": {
            "default": 600,
            "exclusiveMinimum": 0.0,
            "maximum": 86400.0,
            "title": "Cpu Budget Seconds",
            "type": "number"
          },
          "dataset_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Dataset Hash",
            "type": "string"
          },
          "family": {
            "enum": [
              "mean_reversion",
              "momentum",
              "breakout"
            ],
            "title": "Family",
            "type": "string"
          },
          "max_trials": {
            "default": 64,
            "maximum": 256.0,
            "minimum": 1.0,
            "title": "Max Trials",
            "type": "integer"
          },
          "objective": {
            "const": "training-net-return/v1",
            "default": "training-net-return/v1",
            "title": "Objective",
            "type": "string"
          },
          "optimizer": {
            "const": "optuna-tpe/4.5.0-reseed/v1",
            "default": "optuna-tpe/4.5.0-reseed/v1",
            "title": "Optimizer",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/InstrumentSpec"
          },
          "research_kind": {
            "const": "synthetic-training/v1",
            "default": "synthetic-training/v1",
            "title": "Research Kind",
            "type": "string"
          },
          "scenario": {
            "default": "historical-pessimistic/v1",
            "enum": [
              "historical-reference/v1",
              "historical-pessimistic/v1"
            ],
            "title": "Scenario",
            "type": "string"
          },
          "schema_version": {
            "const": "search/v1",
            "default": "search/v1",
            "title": "Schema Version",
            "type": "string"
          },
          "seed": {
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "timeframe": {
            "title": "Timeframe",
            "type": "string"
          },
          "window": {
            "$ref": "#/components/schemas/Window"
          }
        },
        "required": [
          "dataset_hash",
          "profile",
          "window",
          "family",
          "timeframe",
          "code_revision",
          "seed"
        ],
        "title": "SearchProtocol",
        "type": "object"
      },
      "Signal": {
        "additionalProperties": false,
        "properties": {
          "lookback": {
            "maximum": 500.0,
            "minimum": 2.0,
            "title": "Lookback",
            "type": "integer"
          },
          "operator": {
            "enum": [
              "mean_reversion",
              "momentum",
              "breakout"
            ],
            "title": "Operator",
            "type": "string"
          },
          "threshold": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 20.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Threshold"
          },
          "version": {
            "const": "1",
            "default": "1",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "operator",
          "lookback",
          "threshold"
        ],
        "title": "Signal",
        "type": "object"
      },
      "StrategySpec": {
        "additionalProperties": false,
        "properties": {
          "confirmations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Confirmations",
            "type": "array"
          },
          "direction": {
            "default": "both",
            "enum": [
              "both",
              "long",
              "short"
            ],
            "title": "Direction",
            "type": "string"
          },
          "instrument": {
            "title": "Instrument",
            "type": "string"
          },
          "max_hold_seconds": {
            "default": 86400,
            "exclusiveMinimum": 0.0,
            "maximum": 86400.0,
            "title": "Max Hold Seconds",
            "type": "integer"
          },
          "schema_version": {
            "const": "strategy/v1",
            "default": "strategy/v1",
            "title": "Schema Version",
            "type": "string"
          },
          "semantic_version": {
            "const": "1",
            "default": "1",
            "title": "Semantic Version",
            "type": "string"
          },
          "signal": {
            "$ref": "#/components/schemas/Signal"
          },
          "stop_ticks": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000000.0,
            "title": "Stop Ticks",
            "type": "integer"
          },
          "target_rr": {
            "const": "3",
            "default": "3",
            "title": "Target Rr",
            "type": "string"
          },
          "timeframe": {
            "title": "Timeframe",
            "type": "string"
          }
        },
        "required": [
          "instrument",
          "timeframe",
          "signal",
          "stop_ticks"
        ],
        "title": "StrategySpec",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Window": {
        "additionalProperties": false,
        "properties": {
          "end_ns": {
            "exclusiveMinimum": 0.0,
            "title": "End Ns",
            "type": "integer"
          },
          "role": {
            "enum": [
              "train_only",
              "selection_oos",
              "final_holdout_unseen",
              "paper_forward"
            ],
            "title": "Role",
            "type": "string"
          },
          "start_ns": {
            "minimum": 0.0,
            "title": "Start Ns",
            "type": "integer"
          }
        },
        "required": [
          "start_ns",
          "end_ns",
          "role"
        ],
        "title": "Window",
        "type": "object"
      }
    }
  },
